{
  "name": "BP Task Template",
  "module": "Batch Projects",
  "doctype": "DocType",
  "engine": "InnoDB",
  "naming_rule": "Random",
  "autoname": "hash",
  "istable": 0,
  "editable_grid": 0,
  "is_submittable": 0,
  "creation": "2026-07-10 00:00:00",
  "modified": "2026-07-10 00:00:00",
  "owner": "Administrator",
  "modified_by": "Administrator",
  "sort_field": "creation",
  "sort_order": "DESC",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "template_name",
      "fieldtype": "Data",
      "label": "Template Name",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "label": "Project",
      "options": "BP Project",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "task_type",
      "fieldtype": "Data",
      "label": "Task Type",
      "default": "Task"
    },
    {
      "fieldname": "priority",
      "fieldtype": "Select",
      "label": "Priority",
      "options": "Highest\nHigh\nMedium\nLow\nLowest",
      "default": "Medium"
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "title_template",
      "fieldtype": "Data",
      "label": "Title Template",
      "description": "Default title used when a task is created from this template"
    },
    {
      "fieldname": "story_points",
      "fieldtype": "Int",
      "label": "Story Points",
      "default": "0"
    },
    {
      "fieldname": "section_details",
      "fieldtype": "Section Break",
      "label": "Details"
    },
    {
      "fieldname": "description",
      "fieldtype": "Text Editor",
      "label": "Description"
    },
    {
      "fieldname": "labels",
      "fieldtype": "Small Text",
      "label": "Labels",
      "description": "List of label IDs from project labels schema"
    },
    {
      "fieldname": "section_items",
      "fieldtype": "Section Break",
      "label": "Subtasks"
    },
    {
      "fieldname": "items",
      "fieldtype": "Table",
      "label": "Items",
      "options": "BP Task Template Item"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ],
  "links": [],
  "actions": [],
  "custom": 0
