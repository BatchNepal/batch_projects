{
  "name": "BP Goal",
  "module": "Batch Projects",
  "doctype": "DocType",
  "engine": "InnoDB",
  "naming_rule": "Set by user",
  "autoname": "field:title",
  "istable": 0,
  "editable_grid": 0,
  "is_submittable": 0,
  "track_changes": 1,
  "sort_field": "creation",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "section_basic",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Title",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "column_break",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "On Track\nAt Risk\nOff Track\nDone",
      "default": "On Track",
      "in_list_view": 1
    },
    {
      "fieldname": "color",
      "fieldtype": "Color",
      "label": "Color"
    },
    {
      "fieldname": "owner_field",
      "fieldtype": "Link",
      "label": "Owner",
      "options": "User",
      "in_list_view": 0
    },
    {
      "fieldname": "section_dates",
      "fieldtype": "Section Break",
      "label": "Dates"
    },
    {
      "fieldname": "start_date",
      "fieldtype": "Date",
      "label": "Start Date"
    },
    {
      "fieldname": "end_date",
      "fieldtype": "Date",
      "label": "End Date"
    },
    {
      "fieldname": "section_details",
      "fieldtype": "Section Break",
      "label": "Details"
    },
    {
      "fieldname": "description",
      "fieldtype": "Text Editor",
      "label": "Description"
    },
    {
      "fieldname": "section_epics",
      "fieldtype": "Section Break",
      "label": "Linked Epics"
    },
    {
      "fieldname": "linked_epics",
      "fieldtype": "Table",
      "label": "Linked Epics",
      "options": "BP Goal Epic Link"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}