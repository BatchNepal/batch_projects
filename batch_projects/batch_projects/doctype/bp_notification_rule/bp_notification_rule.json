{
  "name": "BP Notification Rule",
  "module": "Batch Projects",
  "doctype": "DocType",
  "engine": "InnoDB",
  "naming_rule": "",
  "autoname": "hash",
  "istable": 0,
  "editable_grid": 0,
  "is_submittable": 0,
  "creation": "2026-07-14 00:00:00",
  "modified": "2026-07-14 00:00:00",
  "owner": "Administrator",
  "modified_by": "Administrator",
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "rule_name",
      "fieldtype": "Data",
      "label": "Rule name",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "event",
      "fieldtype": "Select",
      "label": "Event",
      "options": "task.created\ntask.updated\ntask.status_changed\ntask.assigned\ntask.unassigned\ncomment.added\nsprint.started\nsprint.completed",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "label": "Project (blank = every project)",
      "options": "BP Project",
      "in_list_view": 1
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": "1",
      "in_list_view": 1
    },
    {
      "fieldname": "mute",
      "fieldtype": "Check",
      "label": "Mute (suppress the built-in notification instead of adding recipients)",
      "default": "0",
      "in_list_view": 1
    },
    {
      "fieldname": "conditions_json",
      "fieldtype": "JSON",
      "label": "Conditions",
      "default": "[]",
      "description": "[{field, op, value}, ...] evaluated against the task + project fields. op: = != in \"not in\" contains"
    },
    {
      "fieldname": "recipients_json",
      "fieldtype": "JSON",
      "label": "Recipients",
      "default": "[]",
      "description": "[{type, value}, ...] type: assignee | watchers | project_role | user"
    },
    {
      "fieldname": "channels_json",
      "fieldtype": "JSON",
      "label": "Channels",
      "default": "[\"in_app\", \"email\", \"desktop\"]"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ],
  "links": [],
  "actions": [],
  "custom": 0
}
