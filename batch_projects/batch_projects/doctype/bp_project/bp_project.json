   "fieldname": "project_type",
   "fieldtype": "Select",
   "label": "Project Type",
   "options": "internal\ntm\nfixed\nretainer",
   "default": "internal",
   "in_list_view": 0
  },
  {
   "fieldname": "client",
   "fieldtype": "Link",
   "label": "Client",
   "options": "Customer",
   "depends_on": "eval:doc.project_type != 'internal'",
   "ignore_user_permissions": 1
  },
  {
   "fieldname": "currency",
   "fieldtype": "Data",
   "label": "Currency",
   "default": "INR"
