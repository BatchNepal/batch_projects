   "precision": "2",
   "depends_on": "eval:doc.project_type == 'fixed'"
  },
  {
   "fieldname": "hourly_rate",
   "fieldtype": "Float",
   "label": "Hourly Rate",
   "precision": "2",
   "depends_on": "eval:doc.project_type == 'tm' || doc.project_type == 'retainer'"
  },
  {
   "fieldname": "retainer_hours",
   "fieldtype": "Int",
