   "label": "Description"
  },
  {
   "fieldname": "column_break_details",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "lead",
   "fieldtype": "Link",
   "label": "Project Lead",
   "options": "User"
  },
  {
   "fieldname": "default_assignee",
   "fieldtype": "Link",
   "label": "Default Assignee",
   "options": "User"
  },
