 "fields": [
  {
   "fieldname": "section_break",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "project_name",
   "fieldtype": "Data",
   "label": "Project Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "key",
   "fieldtype": "Data",
   "label": "Key",
   "reqd": 1,
   "unique": 1,
   "description": "2-6 char prefix for issue IDs (e.g., BIM, FA, HTR)"
  },
  {
   "fieldname": "project_color",
   "fieldtype": "Color",
   "label": "Project Color",
   "default": "#0B6BCB"
  },
  {
   "fieldname": "project_icon",
   "fieldtype": "Data",
   "label": "Project Icon",
   "default": "Folder"
  },
  {
   "fieldname": "theme",
   "fieldtype": "Select",
   "label": "Theme",
   "options": "\nkoalaBlue\nkoalaGreen\nkoalaRed\nnotesOrange\nnotesPurple\ntreasureGray\ntreasureSand\nwhiteboard\nyetiBlue\nyetiGreen",
   "description": "Illustrated project avatar shown in the sidebar and project cards."
  },
  {
   "fieldname": "column_break_main",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Project Status",
   "options": "Active\nArchived\nOn Hold",
   "default": "Active",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "health_override",
   "fieldtype": "Select",
   "label": "Health (override)",
   "options": "\nOn track\nAt risk\nOff track",
   "description": "Phase 22B — blank (default) = auto-derived from overdue %, done % vs elapsed time, and target-date slip. Set explicitly to override the computed value in Portfolio."
  },
  {
   "fieldname": "visibility",
   "fieldtype": "Select",
   "label": "Visibility",
   "options": "workspace\nprivate\nteam",
   "default": "workspace"
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "in_standard_filter": 1,
   "ignore_user_permissions": 1
  },
  {
   "fieldname": "parent_project",
   "fieldtype": "Link",
   "label": "Parent Project (WBS)",
   "options": "BP Project",
   "description": "For project hierarchy / WBS breakdown. Child projects inherit visibility from parent."
  },
  {
   "fieldname": "team",
   "fieldtype": "Link",
   "label": "Team",
   "options": "BP Team"
  },
  {
   "fieldname": "category",
   "fieldtype": "Data",
   "label": "Category"
  },
  {
   "fieldname": "template_used",
   "fieldtype": "Data",
   "label": "Template Used",
