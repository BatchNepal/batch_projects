{
  "name": "BP Workflow Run",
  "module": "Batch Projects",
  "doctype": "DocType",
  "engine": "InnoDB",
  "autoname": "hash",
  "naming_rule": "Random",
  "creation": "2026-07-18 00:00:00",
  "modified": "2026-08-23 00:00:00",
  "owner": "Administrator",
  "modified_by": "Administrator",
  "sort_field": "creation",
  "sort_order": "DESC",
  "track_changes": 0,
  "fields": [
    {
      "fieldname": "telemetry_key",
      "fieldtype": "Data",
      "label": "Telemetry Key",
      "unique": 1,
      "hidden": 1,
      "read_only": 1,
      "description": "sha256(run_id or execution, node_id, attempt) — database-level idempotency for the write itself. A get_value()-then-insert check is a race under concurrency (two redelivered/concurrent writers can both see \"not found\"); the unique index makes the DB the actual arbiter, with the second writer's insert failing and falling back to an update of the row the first one just created."
    },
    {
      "fieldname": "workflow",
      "fieldtype": "Link",
      "label": "Workflow",
      "options": "BP Workflow",
      "in_standard_filter": 1
    },
    {
      "fieldname": "run_id",
      "fieldtype": "Data",
      "label": "Run ID",
      "in_standard_filter": 1,
      "description": "Groups every node-row from one graph execution — the UI renders 'this run touched n1->n2->n3' by grouping on this."
    },
    {
      "fieldname": "execution",
      "fieldtype": "Link",
      "label": "Execution",
      "options": "BP Workflow Execution",
      "in_standard_filter": 1,
      "description": "Durable execution authority; run_id remains Gateway trace history."
    },
    {
      "fieldname": "node_id",
      "fieldtype": "Data",
      "label": "Node ID"
    },
    {
      "fieldname": "node_type",
      "fieldtype": "Data",
      "label": "Node Type"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Success\nSkipped\nFailed",
      "in_standard_filter": 1
    },
    {
      "fieldname": "message",
      "fieldtype": "Small Text",
      "label": "Message"
    },
    {
      "fieldname": "run_at",
      "fieldtype": "Datetime",
      "label": "Run At"
    },
    {
      "fieldname": "section_execution",
      "fieldtype": "Section Break",
      "label": "Execution Metadata",
      "collapsible": 1
    },
    {
      "fieldname": "correlation_id",
      "fieldtype": "Data",
      "label": "Correlation ID",
      "description": "Links this node execution back to the originating event — same ID threaded through BP Activity and BP Audit Log for end-to-end tracing."
    },
    {
      "fieldname": "source",
      "fieldtype": "Select",
      "label": "Source",
      "options": "\nevent\nschedule\ngateway\nwebhook\nmanual",
      "description": "What initiated this workflow execution."
    },
    {
      "fieldname": "attempt",
      "fieldtype": "Int",
      "label": "Attempt",
      "default": "1",
      "description": "Number of attempts taken by this node execution."
    },
    {
      "fieldname": "column_break_exec",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "started_at",
      "fieldtype": "Datetime",
      "label": "Started At"
    },
    {
      "fieldname": "finished_at",
      "fieldtype": "Datetime",
      "label": "Finished At"
    },
    {
      "fieldname": "duration_ms",
      "fieldtype": "Int",
      "label": "Duration (ms)",
      "description": "finished_at - started_at in milliseconds."
    },
    {
      "fieldname": "error_code",
      "fieldtype": "Data",
      "label": "Error Code",
      "description": "Short machine-readable error class extracted from the exception type."
    }
  ],
  "permissions": [
    {
      "role": "Projects Manager",
      "read": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ],
  "links": [],
  "actions": [],
  "custom": 0
}
