{
  "name": "BP Webhook Token",
  "module": "Batch Projects",
  "doctype": "DocType",
  "engine": "InnoDB",
  "autoname": "hash",
  "naming_rule": "Random",
  "creation": "2026-07-18 00:00:00",
  "modified": "2026-08-21 00:00:00",
  "owner": "Administrator",
  "modified_by": "Administrator",
  "sort_field": "creation",
  "sort_order": "DESC",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "label",
      "fieldtype": "Data",
      "label": "Label",
      "reqd": 1,
      "description": "What this hook is for, e.g. \"Stripe payments\" or \"Booking site\"."
    },
    {
      "fieldname": "token",
      "fieldtype": "Data",
      "label": "Token",
      "unique": 1,
      "read_only": 1,
      "in_standard_filter": 1,
      "description": "Opaque routing key used in POST /v1/hooks/<token>. Rotate by revoking and creating a new token."
    },
    {
      "fieldname": "signing_secret",
      "fieldtype": "Password",
      "label": "Signing Secret",
      "read_only": 1,
      "hidden": 1,
      "no_copy": 1,
      "description": "Per-webhook HMAC secret. Returned only when the token is created or explicitly rotated; the gateway reads it only through the service-only data adapter."
    },
    {
      "fieldname": "scope",
      "fieldtype": "Select",
      "label": "Scope",
      "options": "workspace\nproject",
      "default": "project",
      "reqd": 1,
      "description": "project: only that project's automation definitions can match. workspace: only workspace-scope definitions can match."
    },
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "label": "Project",
      "options": "BP Project",
      "depends_on": "eval:doc.scope=='project'",
      "mandatory_depends_on": "eval:doc.scope=='project'"
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Active",
      "default": "1",
      "in_standard_filter": 1
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "call_count",
      "fieldtype": "Int",
      "label": "Calls Received",
      "read_only": 1,
      "default": "0"
    },
    {
      "fieldname": "last_used",
      "fieldtype": "Datetime",
      "label": "Last Used",
      "read_only": 1
    },
    {
      "fieldname": "last_event",
      "fieldtype": "Data",
      "label": "Last Event Name",
      "read_only": 1,
      "description": "The X-BP-Event value from the most recent verified call."
    }
  ],
  "permissions": [
    {
      "role": "Projects Manager",
      "read": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ],
  "links": [],
  "actions": [],
  "custom": 0
}
