{
  "name": "BP Notification Template",
  "module": "Batch Projects",
  "doctype": "DocType",
  "engine": "InnoDB",
  "naming_rule": "By fieldname",
  "autoname": "field:event_key",
  "istable": 0,
  "editable_grid": 0,
  "is_submittable": 0,
  "creation": "2026-07-14 00:00:00",
