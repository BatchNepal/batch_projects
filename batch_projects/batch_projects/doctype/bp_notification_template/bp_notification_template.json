    },
    {
      "fieldname": "body",
      "fieldtype": "Code",
      "options": "HTML",
      "label": "Body (HTML)",
      "description": "Jinja-rendered HTML, dropped into the standard email shell (header/footer stay the code default)."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ],
  "links": [],
  "actions": [],
  "custom": 0
