{
  "name": "BP Integration Credential",
  "module": "Batch Projects",
  "doctype": "DocType",
  "engine": "InnoDB",
  "autoname": "hash",
  "naming_rule": "Random",
  "creation": "2026-07-18 00:00:00",
  "modified": "2026-07-18 00:00:00",
  "owner": "Administrator",
  "modified_by": "Administrator",
  "sort_field": "creation",
  "sort_order": "DESC",
  "track_changes": 0,
  "fields": [
    {
      "fieldname": "label",
      "fieldtype": "Data",
      "label": "Label",
      "reqd": 1,
      "in_list_view": 1,
      "description": "Shown in the canvas's credential picker — never the value itself."
    },
    {
      "fieldname": "credential_type",
      "fieldtype": "Select",
      "label": "Type",
      "options": "bearer_token\napi_key\nbasic_auth\ncustom_header\nwebhook_url\nbot_token\nslack_oauth\ndiscord_oauth\nteams_oauth\ngoogle_oauth",
      "default": "bearer_token",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "value",
      "fieldtype": "Password",
      "label": "Value",
      "description": "Encrypted at rest by Frappe's standard Password field handling. Write-only from the frontend's perspective — set it, never read it back."
    },
    {
      "fieldname": "extra_headers",
      "fieldtype": "JSON",
      "label": "Extra Headers",
      "default": "{}",
      "depends_on": "eval:doc.credential_type=='custom_header'"
    },
    {
      "fieldname": "section_oauth",
      "fieldtype": "Section Break",
      "label": "OAuth",
      "depends_on": "eval:['slack_oauth','discord_oauth','teams_oauth','google_oauth','github_oauth'].includes(doc.credential_type)"
    },
    {
      "fieldname": "access_token",
      "fieldtype": "Password",
      "label": "Access Token"
    },
    {
      "fieldname": "refresh_token",
      "fieldtype": "Password",
      "label": "Refresh Token"
    },
    {
      "fieldname": "token_expiry",
      "fieldtype": "Datetime",
      "label": "Token Expiry"
    },
    {
      "fieldname": "oauth_scopes",
      "fieldtype": "Small Text",
      "label": "OAuth Scopes"
    },
    {
      "fieldname": "owner_project",
      "fieldtype": "Link",
      "label": "Owner Project",
      "options": "BP Project",
      "description": "Optional — if set, only usable in that project's workflows. Blank = usable workspace-wide."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ],
  "links": [],
  "actions": [],
  "custom": 0
}
