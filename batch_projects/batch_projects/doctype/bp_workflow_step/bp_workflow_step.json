{
  "name": "BP Workflow Step",
  "module": "Batch Projects",
  "doctype": "DocType",
  "engine": "InnoDB",
  "autoname": "hash",
  "naming_rule": "Random",
  "track_changes": 0,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    {"fieldname": "step_key", "fieldtype": "Data", "label": "Step Key", "reqd": 1, "unique": 1, "read_only": 1},
    {"fieldname": "execution", "fieldtype": "Link", "label": "Execution", "options": "BP Workflow Execution", "reqd": 1, "in_standard_filter": 1, "search_index": 1},
    {"fieldname": "node_id", "fieldtype": "Data", "label": "Node ID", "reqd": 1},
    {"fieldname": "effect_kind", "fieldtype": "Select", "label": "Effect Kind", "options": "frappe_atomic\nexternal", "reqd": 1, "read_only": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "claimed\ndispatching\nsucceeded\nfailed\nneeds_review", "default": "claimed", "reqd": 1, "in_standard_filter": 1, "read_only": 1},
    {"fieldname": "dispatch_started_at", "fieldtype": "Datetime", "label": "Dispatch Started At", "read_only": 1},
    {"fieldname": "error_code", "fieldtype": "Data", "label": "Error Code", "read_only": 1},
    {"fieldname": "error_message", "fieldtype": "Small Text", "label": "Error Message", "read_only": 1},
    {"fieldname": "result_json", "fieldtype": "JSON", "label": "Result JSON", "read_only": 1}
  ],
  "permissions": [
    {"role": "Projects Manager", "read": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
  ]
}
